# docker compose
POSTGRES_PASSWORD=troque-esta-senha

# Execução local da API (cargo run)
DATABASE_URL=postgres://familia:troque-esta-senha@localhost:5432/familia
BIND_ADDR=127.0.0.1:8080
CORS_ORIGINS=http://localhost:5173
SESSION_TTL_DAYS=14
# true apenas atrás de um proxy reverso confiável (usa X-Forwarded-For no rate limit)
TRUST_PROXY=false
# json em produção
LOG_FORMAT=pretty
RUST_LOG=info,sqlx=warn
